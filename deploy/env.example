# Copy to /etc/nadhi/env on the server (owner root, mode 600). Placeholders only: NEVER commit the real file.
# The admin (postgres) connection string must NEVER be on the server.
NADHI_ENV_FILE=/etc/nadhi/env
APP_DOMAIN=app.<your-domain>
NODE_ENV=production
PORT=3000
# PRODUCTION app_backend login (Session pooler host, user app_backend.<project-ref>)
APP_DB_URL=postgresql://app_backend.<project-ref>:<app-password>@<pooler-host>:5432/postgres?sslmode=require
# Public certificate file shipped in the image (certs/supabase-ca.crt); replace the file if the production project differs
DB_CA_CERT_FILE=certs/supabase-ca.crt
# NEW random value for production, at least 32 characters (64 hex is good). Never reuse the dev one.
SESSION_SECRET=<long random string>
