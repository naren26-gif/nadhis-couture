# Copy to .env (which is git-ignored) and fill in. NEVER commit the real file. This example file must hold placeholders only.
# Admin connection: only for schema changes, loading data and backups. Never used by the running app.
DEV_ADMIN_DB_URL=postgresql://postgres.<project-ref>:<admin-password>@<pooler-host>:5432/postgres?sslmode=require
# Application connection: what the backend uses (limited role created by db/supabase_hardening.sql)
APP_DB_URL=postgresql://app_backend.<project-ref>:<app-password>@<pooler-host>:5432/postgres?sslmode=require
# Public certificate of the database's certificate authority (Supabase: Project Settings > Database > SSL Configuration >
# Download certificate). Needed so the app can verify the encrypted connection. Not a secret.
DB_CA_CERT_FILE=certs/supabase-ca.crt
# Secret used to sign login cookies. Use a long random string (at least 32 characters), different on every environment.
SESSION_SECRET=<long random string, at least 32 characters>
# Port the backend listens on (default 3000)
PORT=3000
# Set to production when deployed (turns on secure cookies)
NODE_ENV=development
